# ─────────────────────────────────────────────────────────────────────────────
# Pulse API — Environment Variables
# Copy this file to .env and fill in your values
# ─────────────────────────────────────────────────────────────────────────────

# ── Server mode ───────────────────────────────────────────────────────────────
ENV=production         # "development" or "production"
PORT=8000                # Port (Railway/Render/Fly.io inject this automatically)
HOST=0.0.0.0
WORKERS=1                # Must remain 1 while using the built-in JSON/WebSocket stores
MAX_CONCURRENCY=500      # Per-process connection guard; tune to host capacity
MAX_REQUESTS=10000       # Set 0 to disable recycling
LOG_LEVEL=info           # debug | info | warning | error

# ── Firebase ──────────────────────────────────────────────────────────────────
FIREBASE_PROJECT_ID=my-platform-13264
# Development accepts mock/dev test tokens by default. Production fails closed;
# do not enable either insecure switch on an internet-facing host.
# ALLOW_DEV_TOKENS=true
# ALLOW_INSECURE_FIREBASE_TOKENS=true

# ── CORS (comma-separated, no spaces) ────────────────────────────────────────
# Leave blank in development (all localhost origins allowed by default)
# In production set to your actual domain(s):
# CORS_ORIGINS=https://mypulse.app,https://www.mypulse.app
CORS_ORIGINS=
# Optional only when you control every matching origin. Leave blank for strict
# explicit-origin allowlisting (recommended).
CORS_ORIGIN_REGEX=

# Optional path to a pre-built legacy SPA. Never point this at frontend source.
LEGACY_SPA_DIR=

# Required in production to use /api/ai/admin/* maintenance controls. Send it
# only from a trusted operator/tool as the X-AI-Admin-Token request header.
AI_ADMIN_TOKEN=

# ── Database ─────────────────────────────────────────────────────────────────
# Leave blank to use backend/app/database/platform_data.json
DB_FILE_PATH=

# ── AI Embedding Model ────────────────────────────────────────────────────────
# Smaller = faster startup, larger = better quality
# Options: intfloat/multilingual-e5-small (default, fast)
#          intfloat/multilingual-e5-base (better quality, ~200MB)
PULSE_EMBEDDING_MODEL=intfloat/multilingual-e5-small
# Keep these three values aligned when changing the model. A version change
# makes stale vectors re-embed rather than mixing incompatible vector spaces.
PULSE_EMBEDDING_DIM=384
PULSE_EMBEDDING_MODEL_VERSION=me5-small-v1
# Optional quality deployment: multilingual-e5-base / 768 / me5-base-v1
# PULSE_EMBEDDING_MODEL=intfloat/multilingual-e5-base
# PULSE_EMBEDDING_DIM=768
# PULSE_EMBEDDING_MODEL_VERSION=me5-base-v1

# AI throughput and latency tuning. Start with defaults; increase workers only
# when the host has spare CPU/GPU capacity because model inference is serialized
# safely per model instance.
PULSE_AI_DEVICE=
PULSE_EMBEDDING_BATCH_SIZE=32
PULSE_AI_WORKER_THREADS=2
PULSE_AI_QUEUE_MAX=500
PULSE_RERANKER_CANDIDATE_LIMIT=40
PULSE_FEED_AI_CANDIDATE_LIMIT=250
PULSE_FEED_MMR_CANDIDATE_LIMIT=120
PULSE_RELATED_CACHE_TTL_SECONDS=900
